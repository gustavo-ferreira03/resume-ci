{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gustavo-ferreira03/resume-ci/lib/schema.json",
  "title": "resume-ci JSON Resume Schema",
  "description": "Generated from lib/src/schema.ts. Do not edit manually.",
  "type": "object",
  "properties": {
    "meta": {
      "default": {},
      "type": "object",
      "properties": {
        "template": {
          "default": "default",
          "type": "string"
        },
        "font": {
          "default": "New Computer Modern",
          "type": "string",
          "minLength": 1
        },
        "output_filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sections": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "summary",
              "work",
              "volunteer",
              "projects",
              "awards",
              "certificates",
              "publications",
              "education",
              "skills",
              "languages",
              "interests",
              "references"
            ]
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "locale": {
          "default": "en",
          "type": "string"
        },
        "present_label": {
          "type": "string"
        },
        "canonical": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string"
        },
        "lastModified": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
